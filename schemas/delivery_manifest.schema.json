{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Multi-format Delivery Manifest",
  "type": "object",
  "required": ["schema_version", "figure_id", "canonical_source", "formats", "validation_report"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "figure_id": {"type": "string"},
    "canonical_source": {"type": "string"},
    "formats": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "path", "status", "semantic_editability", "equation_source_editability", "verification"],
        "properties": {
          "format": {"type": "string"},
          "path": {"type": "string"},
          "status": {"type": "string", "enum": ["VERIFIED", "GENERATED_UNVERIFIED", "IMPORT_READY_UNVERIFIED", "BLOCKED"]},
          "semantic_editability": {"type": "boolean"},
          "equation_source_editability": {"type": "boolean"},
          "verification": {"type": "string"}
        }
      }
    },
    "validation_report": {"type": "string"}
  }
}
