{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paper-aware Figure Editorial Review",
  "type": "object",
  "required": [
    "schema_version", "figure_id", "editorial_thesis", "source_inventory",
    "items", "ambiguities", "recommended_wireframe", "conservative_wireframe"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "figure_id": {"type": "string"},
    "editorial_thesis": {"type": "string"},
    "source_inventory": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "classification", "claim", "visual_action", "evidence", "production_impact"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "classification": {
            "type": "string",
            "enum": ["keep", "must-add", "simplify", "remove", "move-to-caption", "ambiguity-blocks-production"]
          },
          "claim": {"type": "string"},
          "visual_action": {"type": "string"},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_path", "locator", "source_hash", "evidence_text"],
              "properties": {
                "source_path": {"type": "string"},
                "locator": {"type": "string"},
                "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "evidence_text": {"type": "string"}
              }
            }
          },
          "production_impact": {"type": "string", "enum": ["required", "optional", "prohibited"]}
        }
      }
    },
    "ambiguities": {"type": "array", "items": {"type": "object"}},
    "recommended_wireframe": {"type": "object"},
    "conservative_wireframe": {"type": "object"}
  }
}
